{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "reload_style_on_change": true,
    "margin-top": 0,
    "margin-bottom": 0,

    "modules-left": ["sway/workspaces"],
    "modules-right": ["clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "tooltip": true,
        "locale": "en_GB.UTF-8",
        "today-format": "<b><u>{}</u></b>",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
