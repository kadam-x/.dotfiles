{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "height": 34,

    "modules-left": ["river/tags"],
    "modules-center": [],
    "modules-right": ["network", "tray", "clock"],

    "river/tags": {
        "num-tags": 9,
        "tag-labels": ["1","2","3","4","5","6","7","8","9"]
    },

    "network": {
        "interface": "wl*",
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-disconnected": "",
        "format-ethernet": "",
        "tooltip-format-wifi": "{ifname} via {gwaddr}"
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "{}",
                "today": "<span color='#6e94b2'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
