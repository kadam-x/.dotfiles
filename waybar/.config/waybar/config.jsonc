{
    "reload_style_on_change": true,
    "layer": "top",
    "height": 20,
    "modules-left": ["sway/workspaces"],
    "modules-center": [],
    "modules-right": ["tray", "network", "battery", "clock"],

    "sway/workspaces": {
        "format": "{icon}"
    },
    "clock": {
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "today": "<span color='#095c74'><b><u>{}</u></b></span>"
            }
        }
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false
    },
    "battery": {
        "interval": 30,
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-full": "BAT full",
        "tooltip": false
    },
}
