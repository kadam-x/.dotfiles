{
    "reload_style_on_change": true,
    "layer": "top",
    "modules-left": ["sway/workspaces", "tray"],
    "modules-center": [],
    "modules-right": ["network", "pulseaudio", "battery", "clock"],
    "sway/workspaces": {
        "format": "{icon}"
    },
    "clock": {
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip": false
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false
    },
    "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "scroll-step": 1,
    "tooltip": false
    },
    "battery": {
        "interval": 30,
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-full": "BAT full",
        "tooltip": false
    },
}
