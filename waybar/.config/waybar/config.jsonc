{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "height": 30,

    "modules-left": ["mango/workspaces"],
    "modules-center": [],
    "modules-right": ["tray", "network", "bluetooth", "pulseaudio", "battery", "clock"],

    "mango/workspaces": {
        "format": "{name}",
        "hide-empty": false,
        "on-click": "activate",
        "on-click-right": "toggle"
    },

    "network": {
        "format-wifi": "w {signalStrength}%",
        "format-ethernet": "eth",
        "format-disconnected": "w off",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} via {gwaddr}",
        "tooltip-format-disconnected": "Disconnected"
    },

    "bluetooth": {
        "format-on": "bt",
        "format-off": "bt off",
        "format-no-controller": "",
        "format-connected": "bt on",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "v {volume}%",
        "format-muted": "v mute",
        "scroll-step": 1
    },

    "battery": {
        "format": "b {capacity}%",
        "format-charging": "b {capacity}%+",
        "tooltip-format": "{capacity}% ({time})",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "{}",
                "today": "<span color='#6e94b2'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
