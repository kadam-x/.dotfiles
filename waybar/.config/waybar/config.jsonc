{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "height": 30,

    "modules-left": ["river/tags"],
    "modules-center": [],
    "modules-right": ["network", "bluetooth", "pulseaudio", "battery", "tray", "clock"],

    "river/tags": {
        "num-tags": 9,
        "tag-labels": ["1","2","3","4","5","6","7","8","9"]
    },

    "network": {
        "interface": "wl*",
        "format-wifi": "󰤨",
        "format-disconnected": "󰤭",
        "format-ethernet": "󰈀",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-disconnected": "Disconnected",
        "tooltip-format-ethernet": "{ifname} via {gwaddr}"
    },

    "bluetooth": {
        "format-on": "",
        "format-off": "",
        "format-connected": "󰂱",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 1
    },

    "battery": {
        "format": "{icon}",
        "format-icons": {
            "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        },
        "tooltip-format": "{capacity}% ({time})",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "{}",
                "today": "<span color='#6e94b2'><b><u>{}</u></b></span>"
            }
        }
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
