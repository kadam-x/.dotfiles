{
    "reload_style_on_change": true,
    "layer": "top",
    "modules-left": ["sway/workspaces", "tray"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "pulseaudio", "battery"],
    "sway/workspaces": {
        "format": "{icon}"
    },
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "{:%a %d %b}"
    },
    "mpris": {
        "player": "spotify",
        "format": "󰏤 ({title} - {artist})",
        "format-paused": "󰐊 ({title} - {artist})",
        "max-length": 40,
        "tooltip": false
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false
    },
    "pulseaudio": {
        "format": "󰋋 {volume}%",
        "format-muted": "󰟎 muted",
        "scroll-step": 1,
        "tooltip": false
    },
    "battery": {
        "interval": 30,
        "format": "BAT {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-full": "BAT full",
        "tooltip": false
    }
}
