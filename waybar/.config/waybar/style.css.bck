* {
  font-family: "JetBrainsMono Nerd Font";
  font-size: 18px;
  border: none;
  border-radius: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
}
window#waybar {
  background: #222222;
  color: #dadada;
}
#workspaces {
  padding-left: 0;
  padding-right: 4px;
}
#workspaces button {
  padding: 0 8px;
  background: transparent;
  color: #747474;
  border-radius: 0;
  border-top: 2px solid #095c74;
}
#workspaces button.focused,
#workspaces button.active {
  background: #095c74;
  color: #ffffff;
  border-top: 2px solid #095c74;
}
.modules-center {
  background: #2e2e2e;
}
#clock {
  padding-left: 10px;
  padding-right: 0;
  color: #dadada;
}
